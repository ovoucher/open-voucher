# Open Voucher app configuration. Export these in the shell, or copy this file to
# app/.env and run `node --env-file=.env dist/src/cli.js ...` (Node 22).
#
# The offline commands (simulate, dedup, report, issue --offline, disburse/expire
# --dry-run, --dry-run on contract calls, serve --demo) need none of these.
# Never commit real secrets. The addresses printed by the offline commands come
# from simulation-only keys derived from public labels (app/src/keys.ts).

# --- network (testnet defaults) --------------------------------------------------
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- contracts (written by scripts/deploy-testnet.sh) -----------------------------
REGISTRY_CONTRACT_ID=
POOL_OVFOOD_ID=
POOL_OVAGRI_ID=

# --- issuer and agency keys (S... secrets, G... public keys) ----------------------
# Issuer master (weight 20). Needed only for `voucher issue` without --offline;
# keep it offline afterwards.
ISSUER_SECRET=
ISSUER_PUBLIC=
# Agency ops key (issuer signer, weight 10): disbursement payments and expiry clawback.
# Also the `fund` / `settle` source.
OPS_SECRET=
OPS_PUBLIC=
# Approval signer (issuer signer, weight 1): can sign only SetTrustLineFlags.
APPROVAL_SIGNER_SECRET=
APPROVAL_SIGNER_PUBLIC=
# merchant_registry admin (enrol / suspend / reinstate / revoke) and verifier (approve).
ADMIN_SECRET=
VERIFIER_SECRET=
# Ed25519 public key (G...) whose signature over sha256(licence-registry.csv) the
# approval server requires before it starts.
AGENCY_PUBKEY=

# --- approval server (voucher serve) ----------------------------------------------
PORT=8080
APPROVAL_SERVER_URL=http://localhost:8080
PROGRAMME_CONFIG=../data/seed/programme.json
RULES_PATH=../data/seed/rules.json
LICENCE_REGISTRY_CSV=../data/seed/licence-registry.csv
LICENCE_REGISTRY_SIG=../data/seed/licence-registry.sig
# JSON file holding recipients, spends, reservations and the onboarding log.
STORE_PATH=out/approval-store.json

# --- wallets used by `voucher pay --from <alias>` / `voucher redeem --merchant <alias>`
# One variable per alias: VOUCHER_SECRET_<ALIAS in upper case>.
VOUCHER_SECRET_MERCHANT=
VOUCHER_SECRET_R0001=

# --- AI (optional; off by default) -------------------------------------------------
# With a key, `--provider llm` drafts donor reports. LLM dedup additionally needs
# "llm_dedup_allowed": true in programme.json (a data-protection sign-off).
# Tests never need a key.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
